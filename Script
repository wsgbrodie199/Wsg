-- [[ 1. PET ESP UTILITY ]]
local function ParsePetValue(text)
    local numericPart = text:match("%$(%d+%.?%d*)")
    if not numericPart then return 0 end
    local value = tonumber(numericPart)
    
    if text:find("T") or text:find("t") then value = value * 1000000000000
    elseif text:find("B") or text:find("b") then value = value * 1000000000
    elseif text:find("M") or text:find("m") then value = value * 1000000 
    elseif text:find("K") or text:find("k") then value = value * 1000 end
    return value
end

local function UpdatePetESP()
    if not getgenv().Toggles.PetESP then 
        getgenv().Toggles.TargetPet = nil
        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "SilencePetHL" then v:Destroy() end
        end
        return 
    end

    local topPet = nil
    local topValue = 300000 

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("TextLabel") and v.Text:find("/s") then
            local currentVal = ParsePetValue(v.Text)
            if currentVal >= topValue then
                topValue = currentVal
                topPet = v:FindFirstAncestorOfClass("Model") or v.Parent
            end
        end
    end

    for _, old in pairs(workspace:GetDescendants()) do
        if old.Name == "SilencePetHL" then old:Destroy() end
    end

    if topPet then
        getgenv().Toggles.TargetPet = topPet
        local hl = Instance.new("Highlight")
        hl.Name = "SilencePetHL"
        hl.FillColor = Color3.fromRGB(0, 255, 0)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.Parent = topPet
    else
        getgenv().Toggles.TargetPet = nil
    end
end

