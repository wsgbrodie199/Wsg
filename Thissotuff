local locked = false
lock.MouseButton1Click:Connect(function()
    locked = not locked f.Draggable = not locked lock.Text = locked and "🔓" or "🔒"
end)

local function upd()
    if enabled then
        tf.BackgroundColor3 = Color3.fromRGB(40, 200, 40)
        knob.Position = UDim2.new(0, 30, 0, 2)
        label.Text = "Base Protector: ON"
        label.TextColor3 = Color3.fromRGB(100, 255, 100)
    else
        tf.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        knob.Position = UDim2.new(0, 2, 0, 2)
        label.Text = "Base Protector: OFF"
        label.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
    if mode == "Kick" then
        mtf.BackgroundColor3 = Color3.fromRGB(100, 100, 255)
        mknob.Position = UDim2.new(0, 30, 0, 2)
        mlabel.TextColor3 = Color3.new(1, 1, 1)
        relabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    else
        mtf.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        mknob.Position = UDim2.new(0, 2, 0, 2)
        mlabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        relabel.TextColor3 = Color3.new(1, 1, 1)
    end
end

tb.MouseButton1Click:Connect(function()
    enabled = not enabled
    upd()
end)

mtb.MouseButton1Click:Connect(function()
    mode = (mode == "Kick") and "Rejoin" or "Kick"
    upd()
end)

upd()
