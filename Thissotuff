--// Base Protector V3 - Minimal UI + 0.046s Delay + Kick/Rejoin Switch (Auto-On)
if not game:IsLoaded() then game.Loaded:Wait() end
local plr, enabled, punished, nr, mode = game.Players.LocalPlayer, true, {}, nil, "Kick"  -- enabled = true now
while not plr do task.wait() plr = game.Players.LocalPlayer end

task.spawn(function()
    local p = game.ReplicatedStorage:WaitForChild("Packages", 5)
    if p then local n = p:WaitForChild("Net", 5) if n then nr = n:FindFirstChild("RE/NotificationService/Notify") end end
end)

local function plot()
    local w = workspace:FindFirstChild("Plots") if not w then return end
    for _, o in pairs(w:GetChildren()) do if o:FindFirstChild("PlotSign") and o.PlotSign:FindFirstChild("YourBase") and o.PlotSign.YourBase.Enabled then return o end end
    for _, o in pairs(w:GetChildren()) do if o.Name:find(plr.Name) then return o end local ow = o:FindFirstChild("Owner") if ow and ow.Value == plr then return o end end
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then local h = plr.Character.HumanoidRootPart for _, o in pairs(w:GetChildren()) do local p = o:FindFirstChild("PlotPart") or o:FindFirstChild("Base") if p and p:IsA("BasePart") and (h.Position - p.Position).Magnitude < 100 then return o end end end
end

local function inplot()
    local p = plot() if not p then return {} end
    local pos, sz, dec = p:GetPivot().Position, 120, p:FindFirstChild("Decorations")
    if dec and dec:FindFirstChild("Model") then pos = dec.Model:GetPivot().Position end
    local t = {} for _, v in ipairs(game.Players:GetPlayers()) do if v ~= plr and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then if (v.Character.HumanoidRootPart.Position - pos).Magnitude < sz then table.insert(t, v) end end end
    return t
end

local function act(name)
    if not name or name == "" or not enabled then return end
    local t = game.Players:FindFirstChild(name) if not t then return end
    task.wait(0.046)
    if mode == "Kick" then
        plr:Kick("KETAMINE IS THE BEST https://discord.gg/e9gpxPPPX")
    else
        game:GetService("TeleportService"):Teleport(game.PlaceId, plr)
    end
end

local function defend(name)
    if not enabled or punished[name] then return end
    punished[name] = true
    act(name)
    task.delay(30, function() punished[name] = nil end)
end

local function start()
    local p for i = 1, 10 do p = plot() if p then break end task.wait(1) end
    if not p then return end
    if nr then nr.OnClientEvent:Connect(function(m) if not enabled or typeof(m) ~= "string" then return end if not m:find("stealing") and not m:find("robbing") then return end task.spawn(function() local pts = inplot() if #pts == 0 then return end if #pts == 1 then defend(pts[1].Name) return end local cp, cd = nil, math.huge local dec, ani = p:FindFirstChild("Decorations"), p:FindFirstChild("AnimalPodiums") for _, v in ipairs(pts) do if v.Character and v.Character:FindFirstChild("HumanoidRootPart") then local hrp, md = v.Character.HumanoidRootPart, math.huge if dec and dec:FindFirstChild("Model") then md = math.min(md, (hrp.Position - dec.Model:GetPivot().Position).Magnitude) end if ani then for _, a in ipairs(ani:GetChildren()) do md = math.min(md, (hrp.Position - a:GetPivot().Position).Magnitude) end end if md < cd then cd = md cp = v end end end if cp then defend(cp.Name) elseif pts[1] then defend(pts[1].Name) end end) end) end
end
start()

